# Copy to .env and fill in what you have. Everything is optional:
# with nothing set the app runs with the demo playlist, keyless song search,
# and public Spotify / Apple Music links.

# --- Spotify (https://developer.spotify.com/dashboard) -----------------------
# Create an app, add the redirect URI  http://127.0.0.1:5173/callback
# (and your production URL + /callback), and paste the Client ID here.
SPOTIFY_CLIENT_ID=
# Optional: lets the server read public albums through the Web API.
SPOTIFY_CLIENT_SECRET=

# --- Apple Music (needs an Apple Developer Program membership) ---------------
# Create a MusicKit key: Certificates, Identifiers & Profiles → Keys → MusicKit.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either the path to the downloaded AuthKey_XXXXXX.p8 file …
APPLE_PRIVATE_KEY_PATH=
# … or its contents (newlines may be written as \n).
APPLE_PRIVATE_KEY=

# --- Map (optional) ------------------------------------------------------------
# Any MapLibre style URL. Defaults to OpenFreeMap (free, no key).
VITE_MAP_STYLE_DARK=
VITE_MAP_STYLE_LIGHT=

# Production server port (npm start)
PORT=8787
